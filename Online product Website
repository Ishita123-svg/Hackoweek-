<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Product Listing Page</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;

    /* Colorful Gradient Background */
    background: linear-gradient(135deg, #ff9a9e, #fad0c4, #a18cd1, #fbc2eb);
}

/* Header */
header {
    text-align: center;
    padding: 40px 20px;
}

/* Big Heading */
header h1 {
    font-size: 3.5em;
    font-weight: 900;
    margin: 0;
    color: black;
    text-shadow: 3px 3px 0 white;
}

header p {
    color: white;
    font-size: 1.2em;
}

/* Grid Layout */
.container {
    width: 90%;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    padding-bottom: 50px;
}

/* Product Card */
.product {
    background: white;
    border-radius: 15px;
    padding: 12px;
    text-align: center;
    transition: 0.3s;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}

.product:hover {
    transform: scale(1.05);
}

/* Image */
.product img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 10px;
}

/* Text */
.product-name {
    font-weight: bold;
    margin: 10px 0 5px;
    color: black;
}

.price {
    color: #444;
    font-size: 1.1em;
}
</style>

</head>

<body>

<header>
    <h1>🛍 My Shop</h1>
    <p>Best Deals for You</p>
</header>

<div class="container">

    <div class="product">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=400&q=80">
        <div class="product-name">Smart Watch</div>
        <div class="price">₹2,999</div>
    </div>

    <div class="product">
        <img src="https://images.unsplash.com/photo-1580894908361-967195033215?auto=format&fit=crop&w=400&q=80">
        <div class="product-name">Laptop</div>
        <div class="price">₹1,499</div>
    </div>

    <div class="product">
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=400&q=80">
        <div class="product-name">Shoes</div>
        <div class="price">₹2,199</div>
    </div>

        

    <div class="product">
        <img src="https://images.unsplash.com/photo-1598327105666-5b89351aff97?auto=format&fit=crop&w=400&q=80">
        <div class="product-name">Mobile Phone</div>
        <div class="price">₹15,999</div>
    </div>

    <div class="product">
        <img src="https://images.unsplash.com/photo-1572635196237-14b3f281503f?auto=format&fit=crop&w=400&q=80">
        <div class="product-name">Sunglasses</div>
        <div class="price">₹499</div>
    </div>

    </body>
</html>
