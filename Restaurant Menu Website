<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Flavor Hub Menu</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;
    color: #fff;

    /* Creative Background */
    background: linear-gradient(135deg, #000000, #1a1a1a, #330000);
    background-attachment: fixed;
}

/* Header */
header {
    text-align: center;
    padding: 25px;
    background: rgba(0,0,0,0.8);
    border-bottom: 3px solid red;
    box-shadow: 0 0 20px red;
}

header h1 {
    margin: 0;
    color: red;
    font-size: 2.5em;
}

/* Container */
.container {
    width: 90%;
    margin: auto;
    padding: 20px 0;
}

/* Row Layout */
.menu-row {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
}

/* Columns */
.menu-column {
    flex: 1;
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(10px);
    padding: 15px;
    border-radius: 15px;
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 0 15px rgba(255,0,0,0.3);
}

.menu-column h2 {
    text-align: center;
    color: #00ff88;
    border-bottom: 2px solid red;
    padding-bottom: 5px;
}

/* Items */
.menu-item {
    text-align: center;
    margin: 20px 0;
    transition: 0.3s;
}

.menu-item img {
    width: 160px;
    height: 110px;
    border-radius: 12px;
    object-fit: cover;
    border: 2px solid red;
    box-shadow: 0 0 10px red;
}

.menu-item:hover {
    transform: scale(1.08);
}

/* Text */
.item-name {
    font-weight: bold;
    margin-top: 10px;
}

.price {
    color: #00ff88;
    font-size: 1.1em;
}

/* Responsive */
@media (max-width: 768px) {
    .menu-row {
        flex-direction: column;
    }
}
</style>

</head>

<body>

<header>
    <h1>🔥 Flavor Hub</h1>
    <p>Delicious Food, Bold Taste</p>
</header>

<div class="container">

    <!-- Row 1 -->
    <div class="menu-row">

        <!-- Starters -->
        <div class="menu-column">
            <h2>Starters</h2>

            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1608032077018-c9aad9565d29?auto=format&fit=crop&w=400&q=80">
                <div class="item-name">Spring Rolls</div>
                <div class="price">₹120</div>
            </div>

            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1601050690597-df0568f70950">
                <div class="item-name">Paneer Tikka</div>
                <div class="price">₹180</div>
            </div>

        </div>

        <!-- Drinks -->
        <div class="menu-column">
            <h2>Drinks</h2>

            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1586190848861-99aa4a171e90">
                <div class="item-name">Cold Coffee</div>
                <div class="price">₹110</div>
            </div>

            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1553530666-ba11a7da3888">
                <div class="item-name">Fresh Juice</div>
                <div class="price">₹90</div>
            </div>

        </div>

    </div>

    <!-- Row 2 -->
    <div class="menu-row">

        <!-- Main Course -->
        <div class="menu-column">
            <h2>Main Course</h2>

            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1603894584373-5ac82b2ae398">
                <div class="item-name">Butter Paneer</div>
                <div class="price">₹250</div>
            </div>

            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1633945274405-b6c8069047b0?auto=format&fit=crop&w=400&q=80">                
<div class="item-name">Veg Biryani</div>
                <div class="price">₹200</div>
            </div>

        </div>

        <!-- Desserts -->
        <div class="menu-column">
            <h2>Desserts</h2>

            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587">
                <div class="item-name">Chocolate Cake</div>
                <div class="price">₹140</div>
            </div>

            <div class="menu-item">
                <img src="https://images.unsplash.com/photo-1563805042-7684c019e1cb">
                <div class="item-name">Ice Cream</div>
                <div class="price">₹120</div>
            </div>

        </div>

    </div>

</div>

</body>
</html>
